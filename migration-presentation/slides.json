    {
      "type": "content",
      "badge": "Issue #1",
      "title": "Shadow DOM vs Light DOM",
      "subtitle": "The Core Difference",
      "twoColumn": {
        "left": {
          "title": "Stencil (Shadow DOM)",
          "bullets": [
            "Encapsulated shadow trees",
            "element.shadowRoot exists",
            "Styles isolated in boundary",
            "DOM queries scoped to shadow"
          ]
        },
        "right": {
          "title": "Vue (Light DOM)",
          "bullets": [
            "Renders directly to document",
            "No shadow root exists",
            "Styles cascade globally",
            "DOM queries scoped to container"
          ]
        }
      },
      "callout": {
        "type": "warning",
        "icon": "⚠️",
        "text": "Problem: Codebase expected ShadowRoot object, but Vue has none"
      }
    },
    {
      "type": "content",
      "badge": "Solution #1",
      "title": "LightDomAdapter",
      "subtitle": "Wrapper providing same method signatures as ShadowRoot",
      "codeCompare": {
        "left": {
          "title": "ShadowRoot API",
          "code": "shadowRoot.getElementById(id)\nshadowRoot.querySelector(sel)\nshadowRoot.appendChild(node)\nshadowRoot.dispatchEvent(evt)"
        },
        "right": {
          "title": "LightDomAdapter",
          "code": "element.querySelector(`#${id}`)\nelement.querySelector(sel)\nelement.appendChild(node)\nelement.dispatchEvent(evt)"
        }
      },
      "note": "Same interface, different implementation — seamless transition"
    },
    {
      "type": "content",
      "badge": "Issue #2",
      "title": "Module Duplication",
      "subtitle": "Multiple Engine Singletons",
      "callout": {
        "type": "warning",
        "icon": "🐛",
        "title": "Symptom",
        "text": "\"Cannot find the parent of the clip {clipId: '...', layerId: '...'}\" error"
      },
      "bullets": [
        "Root Cause: Stencil bundled its own copies of @easyvideo/shared, @rendley/sdk, and mobx",
        "Vue initialized Engine singleton, Stencil used its own uninitialized instance",
        "Two different Engine instances = state completely out of sync"
      ]
    },
    {
      "type": "content",
      "badge": "Solution #2",
      "title": "Externalize Shared Packages",
      "code": "// stencil.config.ts - Custom Rollup plugin\nconst externalPackages = [\n  \"@easyvideo/shared\",\n  \"@rendley/sdk\",\n  \"mobx\"\n];",
      "bullets": [
        "Custom Rollup plugin in stencil.config.ts",
        "Ensures single instance of singletons across both frameworks",
        "Vue initializes Engine, Stencil components consume same instance"
      ]
    },
    {
      "type": "content",
      "badge": "Issue #3",
      "title": "Circular Dependencies",
      "subtitle": "Build failures and runtime errors",
      "bullets": [
        "Some stores and services had bidirectional dependencies",
        "Worked in Stencil's bundling but broke when extracting to shared package"
      ],
      "callout": {
        "type": "info",
        "icon": "💡",
        "title": "Solutions",
        "text": "Callback injection (pass deps during init) + Re-export pattern (intermediate modules break cycle)"
      },
      "note": "Temporary patterns to unblock migration — can be refactored later"
    },
    {
      "type": "content",
      "badge": "Issue #4",
      "title": "Direct DOM Manipulation",
      "subtitle": "Code expecting elements that weren't in the DOM",
      "bullets": [
        "Several parts relied on direct DOM manipulation with &lt;ve-*&gt; custom elements",
        "Assumption: Web components always registered and present",
        "Vue's rendering model doesn't guarantee elements exist at same lifecycle points"
      ],
      "callout": {
        "type": "success",
        "icon": "✅",
        "title": "Solution",
        "text": "Registered Stencil components as custom elements via Vue's app.config.compilerOptions.isCustomElement, so Vue treats <ve-*> tags as native custom elements instead of trying to resolve them as Vue components"
      }
    },
    {
      "type": "content",
      "badge": "Issue #5",
      "title": "MobX vs Vue Reactivity",
      "subtitle": "State changes not triggering re-renders",
      "twoColumn": {
        "left": {
          "title": "MobX",
          "bullets": [
            "Requires full mutation",
            "Replace entire object/array",
            "Observer Pattern-based tracking"
          ]
        },
        "right": {
          "title": "Vue",
          "bullets": [
            "Proxy-based tracking",
            "Property-level detection",
            "Ref/reactive primitives"
          ]
        }
      },
      "callout": {
        "type": "success",
        "icon": "✅",
        "title": "Solution",
        "text": "Used mobx-vue-lite with &lt;Observer&gt; component wrapper to bridge reactivity systems"
      }
    },
